# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/mcpulse?schema=public

# Redis (BullMQ + cache + pub/sub)
REDIS_URL=redis://localhost:6379

# Clerk (platform authentication)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Anthropic (Claude API for AI report generation)
ANTHROPIC_API_KEY=

# AES-256-GCM key for encrypting SFMC credentials (32 bytes hex = 64 chars)
ENCRYPTION_KEY=

# Server
PORT=3001
NODE_ENV=development
